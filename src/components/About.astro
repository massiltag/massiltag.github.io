---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import { getContent } from '../i18n';
import type { Lang } from '../i18n/types';

interface Props {
  lang: Lang;
}

const t = getContent(Astro.props.lang);
---

<section class="section about" id="about">
  <div class="section-inner about-grid">
    <figure class="portrait" data-portrait>
      <div class="portrait-frame">
        <Image
          src={portrait}
          alt={t.about.portraitAlt}
          widths={[420, 640, 894]}
          sizes="(max-width: 860px) 80vw, 34vw"
          class="portrait-img"
          data-parallax="-0.08"
        />
        <span class="portrait-tint" aria-hidden="true"></span>
      </div>
      <span class="portrait-outline" aria-hidden="true"></span>
    </figure>

    <div class="about-copy">
      <p class="section-label">{t.about.label}</p>
      <h2 class="section-title about-title" data-split set:html={t.about.title} />

      <div class="about-text">
        {t.about.paragraphs.map((p) => <p data-reveal>{p}</p>)}
      </div>

      <dl class="stats">
        {
          t.about.stats.map((s) => (
            <div class="stat" data-reveal>
              <dt class="stat-label">{s.label}</dt>
              <dd class="stat-value" data-count={/^\d+$/.test(s.value) ? s.value : undefined}>
                {s.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(3rem, 8vw, 8.125rem);
    align-items: center;
  }

  .portrait {
    position: relative;
    margin: 0;
    max-width: 28.75rem;
  }

  .portrait-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--bg-elev);
  }

  .portrait-frame :global(.portrait-img) {
    width: 100%;
    height: 116%;
    margin-top: -8%;
    object-fit: cover;
    object-position: 50% 30%;
    filter: grayscale(1) contrast(1.08) brightness(0.92);
  }

  /* cool grade over the black and white photo */
  .portrait-tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(170, 180, 255, 0.18), rgba(79, 91, 213, 0.12) 55%, rgba(11, 12, 15, 0.55));
    mix-blend-mode: soft-light;
  }

  .portrait-outline {
    position: absolute;
    inset: 1.375rem -1.375rem -1.375rem 1.375rem;
    border: 1px solid rgba(124, 140, 255, 0.35);
    border-radius: 0.25rem;
    z-index: -1;
  }

  .about-title {
    max-width: 13ch;
  }

  .about-text {
    margin-top: 2.5rem;
    display: grid;
    gap: 1.125rem;
    max-width: 58ch;
    color: var(--ink-dim);
    font-size: 1.0313rem;
  }

  .about-text p:first-child {
    color: var(--ink);
  }

  .stats {
    margin: 3.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.375rem;
    padding: 1.625rem 1.25rem 0 0;
  }

  .stat + .stat {
    padding-left: 1.375rem;
    border-left: 1px solid var(--line);
  }

  .stat-value {
    margin: 0;
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(2.375rem, 4.2vw, 3.625rem);
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: lining-nums tabular-nums;
  }

  .stat-label {
    font-family: var(--mono);
    font-size: 0.7188rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  @media (max-width: 53.75rem) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .portrait {
      max-width: min(23.75rem, 82vw);
    }
  }

  @media (max-width: 32.5rem) {
    .stats {
      grid-template-columns: 1fr;
    }

    .stat + .stat {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
      margin-top: 1.375rem;
    }
  }
</style>

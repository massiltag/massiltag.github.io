---
import { getContent } from '../i18n';
import type { Credential, Lang } from '../i18n/types';

interface Props {
  lang: Lang;
}

const t = getContent(Astro.props.lang);

const groups: { title: string; items: Credential[] }[] = [
  { title: t.education.degreesTitle, items: t.education.degrees },
  { title: t.education.certificationsTitle, items: t.education.certifications },
];
---

<section class="section education" id="education">
  <div class="section-inner">
    <header class="education-head">
      <p class="section-label">{t.education.label}</p>
      <h2 class="section-title" data-split set:html={t.education.title} />
    </header>

    <div class="groups">
      {
        groups.map((g) => (
          <div class="group">
            <h3 class="group-title" data-reveal>{g.title}</h3>
            <ul class="credentials">
              {g.items.map((c) => (
                <li class="credential" data-reveal>
                  <span class="credential-year">{c.year}</span>
                  <div>
                    <h4 class="credential-title">{c.title}</h4>
                    <p class="credential-issuer">{c.issuer}</p>
                    <p class="credential-description">{c.description}</p>
                    {c.modules && (
                      <p class="credential-modules">
                        {c.modules.map((m, i) => (
                          <span>
                            {m}
                            {i < c.modules!.length - 1 && <span class="dot" aria-hidden="true"> · </span>}
                          </span>
                        ))}
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .education-head {
    margin-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  .groups {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 7vw, 6.875rem);
  }

  .group-title {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding-bottom: 1.125rem;
    border-bottom: 1px solid var(--line);
  }

  .credentials {
    list-style: none;
    padding: 0;
  }

  .credential {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 1.125rem;
    padding: 2.125rem 0;
    border-bottom: 1px solid var(--line);
  }

  .credential-year {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--accent);
    padding-top: 0.3125rem;
  }

  .credential-title {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.1875rem, 1.7vw, 1.4375rem);
    line-height: 1.3;
    letter-spacing: -0.025em;
  }

  .credential-issuer {
    margin-top: 0.5rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--accent-soft);
  }

  .credential-description {
    margin-top: 0.875rem;
    color: var(--ink-dim);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .credential-modules {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    line-height: 1.8;
    color: var(--ink-faint);
  }

  .dot {
    color: var(--accent-deep);
  }

  @media (max-width: 56.25rem) {
    .groups {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 32.5rem) {
    .credential {
      grid-template-columns: 1fr;
      gap: 0.375rem;
    }

    .credential-year {
      padding-top: 0;
    }
  }
</style>

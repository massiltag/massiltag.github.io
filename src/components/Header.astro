---
import { getContent, pathFor } from '../i18n';
import type { Lang } from '../i18n/types';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
const other: Lang = lang === 'fr' ? 'en' : 'fr';

const links = [
  { href: '#about', label: t.nav.about },
  { href: '#experience', label: t.nav.experience },
  { href: '#projects', label: t.nav.projects },
  { href: '#education', label: t.nav.education },
  { href: '#contact', label: t.nav.contact },
];
---

<header class="header">
  <a class="monogram" href="#top" aria-label="Massil Taguemout">
    <span>M</span><span class="monogram-t">T</span>
  </a>

  <nav class="nav" aria-label="Navigation">
    <ul>
      {
        links.map((link, i) => (
          <li>
            <a href={link.href} class="nav-link">
              <span class="nav-index">0{i + 1}</span>
              <span class="nav-text">{link.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="tools">
    <button class="sound" type="button" aria-pressed="false" data-label-on={t.ui.soundOff} data-label-off={t.ui.soundOn} aria-label={t.ui.soundOn}>
      <span class="sound-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span class="sound-text">{t.ui.sound}</span>
    </button>

    <div class="lang" role="group" aria-label="Language">
      <span class="lang-current" aria-current="true">{lang.toUpperCase()}</span>
      <span class="lang-sep" aria-hidden="true">/</span>
      <a class="lang-other" href={pathFor(other)} hreflang={other} lang={other} aria-label={t.ui.otherLanguage} data-lang-switch>
        {other.toUpperCase()}
      </a>
    </div>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <span class="visually-hidden">Menu</span>
      <span class="menu-lines" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" hidden>
  <ul>
    {
      links.map((link, i) => (
        <li>
          <a href={link.href} class="mobile-link">
            <span class="nav-index">0{i + 1}</span>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 70;
    height: var(--header-h);
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    transition: background-color 0.5s ease, border-color 0.5s ease, backdrop-filter 0.5s ease;
    border-bottom: 1px solid transparent;
  }

  :global(.scrolled) .header {
    background-color: rgba(11, 12, 15, 0.72);
    backdrop-filter: blur(0.875rem) saturate(1.2);
    -webkit-backdrop-filter: blur(0.875rem) saturate(1.2);
    border-bottom-color: var(--line);
  }

  .monogram {
    font-family: var(--display);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 1;
    display: inline-flex;
    padding: 0.375rem 0;
  }

  .monogram-t {
    color: var(--accent);
    margin-left: 0.01em;
  }

  .nav ul {
    list-style: none;
    padding: 0;
    display: flex;
    gap: clamp(1.125rem, 2.6vw, 2.5rem);
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    padding: 0.375rem 0;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    color: var(--ink-dim);
    transition: color 0.3s ease;
  }

  .nav-index {
    font-family: var(--mono);
    font-size: 0.625rem;
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  .nav-text {
    position: relative;
  }

  .nav-text::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.25rem;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.5s var(--ease-out);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--ink);
  }

  .nav-link:hover .nav-text::after,
  .nav-link.is-active .nav-text::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 1.375rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .sound {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.375rem 0;
    border: 0;
    background: none;
    color: var(--ink-dim);
    font: inherit;
    letter-spacing: inherit;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .sound:hover,
  .sound[aria-pressed='true'] {
    color: var(--ink);
  }

  .sound-bars {
    display: inline-flex;
    align-items: flex-end;
    gap: 0.125rem;
    height: 0.75rem;
  }

  .sound-bars i {
    width: 0.125rem;
    height: 0.1875rem;
    background: var(--accent);
    transition: height 0.3s ease;
  }

  .sound[aria-pressed='true'] .sound-bars i {
    animation: bars 1.1s ease-in-out infinite;
  }

  .sound[aria-pressed='true'] .sound-bars i:nth-child(2) { animation-delay: -0.4s; }
  .sound[aria-pressed='true'] .sound-bars i:nth-child(3) { animation-delay: -0.75s; }
  .sound[aria-pressed='true'] .sound-bars i:nth-child(4) { animation-delay: -0.2s; }

  @keyframes bars {
    0%, 100% { height: 0.1875rem; }
    50% { height: 0.75rem; }
  }

  .lang {
    display: inline-flex;
    gap: 0.375rem;
    color: var(--ink-faint);
  }

  .lang-current {
    color: var(--accent);
  }

  .lang-other {
    color: var(--ink-dim);
    transition: color 0.3s ease;
  }

  .lang-other:hover {
    color: var(--ink);
  }

  .menu-toggle {
    display: none;
    width: 2.125rem;
    height: 2.125rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }

  .menu-lines {
    position: relative;
    display: block;
    width: 1.5rem;
    height: 0.625rem;
    margin: 0 auto;
  }

  .menu-lines i {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: currentColor;
    transition: transform 0.45s var(--ease-out), top 0.45s var(--ease-out);
  }

  .menu-lines i:first-child { top: 0; }
  .menu-lines i:last-child { top: 0.5625rem; }

  .menu-toggle[aria-expanded='true'] .menu-lines i:first-child {
    top: 0.3125rem;
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-lines i:last-child {
    top: 0.3125rem;
    transform: rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 65;
    display: flex;
    align-items: center;
    padding: var(--header-h) var(--gutter) 2.5rem;
    background: rgba(11, 12, 15, 0.97);
    backdrop-filter: blur(0.625rem);
    -webkit-backdrop-filter: blur(0.625rem);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .mobile-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.875rem;
    font-family: var(--display);
    font-weight: 600;
    letter-spacing: -0.045em;
    font-size: clamp(2.25rem, 10vw, 3.5rem);
    line-height: 1.15;
  }

  .mobile-link .nav-index {
    font-family: var(--sans);
    font-size: 0.6875rem;
  }

  @media (max-width: 60rem) {
    .nav {
      display: none;
    }

    .menu-toggle {
      display: block;
    }
  }

  @media (max-width: 26.25rem) {
    .sound-text {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sound[aria-pressed='true'] .sound-bars i {
      animation: none;
      height: 0.5625rem;
    }
  }
</style>
